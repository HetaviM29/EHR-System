<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HealthConnect Doctor Dashboard</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Arial', sans-serif;
    }

    body {
      display: grid;
      grid-template-columns: 250px 1fr;
      grid-template-rows: auto 1fr;
      height: 100vh;
      background-color: #f4f7f6;
    }

    .header {
      grid-column: 1 / 3;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px;
      background-color: #2c3e50;
      color: white;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .header h1 {
      font-size: 24px;
      font-weight: 300;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .avatar {
      width: 50px;
      height: 50px;
      background-color: #3498db;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      color: white;
    }

    .sidebar {
      background-color: #34495e;
      color: white;
      padding-top: 20px;
    }

    .menu-item {
      padding: 15px 20px;
      cursor: pointer;
      transition: background-color 0.3s ease;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .menu-item:hover {
      background-color: #2c3e50;
    }

    .menu-item.active {
      background-color: #3498db;
    }

    .menu-item i {
      margin-right: 10px;
      width: 20px;
      text-align: center;
    }

    .main-content {
      padding: 20px;
      background-color: white;
      margin: 20px;
      border-radius: 8px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .patient-search {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
    }

    .patient-search input {
      flex-grow: 1;
      padding: 10px;
      border: 1px solid #ddd;
      border-radius: 4px;
    }

    .patient-search button {
      padding: 10px 15px;
      background-color: #3498db;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }

    .patient-search button:hover {
      background-color: #2980b9;
    }

    .patient-details {
      background-color: #f9f9f9;
      padding: 20px;
      border-radius: 8px;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>HealthConnect Doctor Dashboard</h1>
    <div class="user-info">
      <div class="avatar">Doc</div>
      <div>
        <div><%= doctor.name %></div>
        <div style="font-size: 12px;"><%= doctor.specialty %></div>
      </div>
    </div>
  </div>

  <div class="sidebar">
    <div class="menu-item active"><i class="fas fa-chart-line"></i>Dashboard</div>
    <div class="menu-item"><i class="fas fa-users"></i>My Patients</div>
    <div class="menu-item"><i class="fas fa-calendar-check"></i>Appointments</div>
    <div class="menu-item"><i class="fas fa-prescription-bottle"></i>Prescriptions</div>
    <div class="menu-item"><i class="fas fa-flask"></i>Lab Results</div>
    <div class="menu-item"><i class="fas fa-comment-medical"></i>Messages</div>
    <div class="menu-item"><i class="fas fa-calendar-alt"></i>Calendar</div>
    <div class="menu-item"><i class="fas fa-cog"></i>Settings</div>
  </div>  

  <div class="main-content">
    <div class="patient-search">
      <input type="text" id="patientIdInput" placeholder="Enter Patient ID">
      <button onclick="fetchPatientDetails()">Search Patient</button>
    </div>

    <div id="patientDetailsContainer" class="patient-details">
      <p>Patient details will appear here after searching</p>
    </div>
  </div>

  <script>
    function fetchPatientDetails() {
      const patientId = document.getElementById('patientIdInput').value;
      const detailsContainer = document.getElementById('patientDetailsContainer');

      if (!patientId) {
        detailsContainer.innerHTML = '<p>Please enter a Patient ID</p>';
        return;
      }

      // Simulated patient data fetch (replace with actual API call)
      const patientData = {
        1: { 
          name: 'John Doe', 
          age: 45, 
          gender: 'Male', 
          condition: 'Hypertension', 
          lastVisit: '2024-03-15' 
        },
        2: { 
          name: 'Jane Smith', 
          age: 35, 
          gender: 'Female', 
          condition: 'Diabetes', 
          lastVisit: '2024-03-20' 
        }
      };

      const patient = patientData[patientId];

      if (patient) {
        detailsContainer.innerHTML = `
          <h3>Patient Details</h3>
          <p><strong>Name:</strong> ${patient.name}</p>
          <p><strong>Age:</strong> ${patient.age}</p>
          <p><strong>Gender:</strong> ${patient.gender}</p>
          <p><strong>Condition:</strong> ${patient.condition}</p>
          <p><strong>Last Visit:</strong> ${patient.lastVisit}</p>
        `;
      } else {
        detailsContainer.innerHTML = '<p>Patient not found</p>';
      }
    }
  </script>
</body>
</html>